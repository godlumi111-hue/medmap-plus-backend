# Copier ce fichier en .env et remplir les valeurs

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medmap_plus

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Serveur
PORT=5000
NODE_ENV=development

# Frontend (pour CORS)
FRONTEND_URL=http://localhost:3000
